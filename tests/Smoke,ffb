2700 DEF FNexists(file$)
2710 LOCAL obj%
2720 SYS "OS_File",5,file$ TO obj%
2730 =obj%<>0
2800 DEF FNisdir(file$)
2810 LOCAL obj%
2820 SYS "OS_File",5,file$ TO obj%
2830 =obj%=2
2900 DEF FNfiletype(file$)
2910 LOCAL obj%,type%
2920 SYS "OS_File",5,file$ TO obj%
2930 IF obj%=0 THEN =-1
2940 SYS "OS_File",23,file$ TO,,,,,,type%
2950 =type%
3000 DEF FNfirstbyte(file$)
3010 LOCAL ch%,byte%
3020 ch%=OPENIN(file$)
3030 IF ch%=0 THEN =-1
3040 byte%=BGET#ch%
3050 CLOSE#ch%
3060 =byte%
3100 DEF FNbyteat(file$,offset%)
3110 LOCAL ch%,byte%
3120 ch%=OPENIN(file$)
3130 IF ch%=0 THEN =-1
3140 PTR#ch%=offset%
3150 byte%=BGET#ch%
3160 CLOSE#ch%
3170 =byte%
3200 DEF FNgbpbfirst(file$)
3210 LOCAL ch%,buf%,unread%
3220 DIM buf% 0
3230 ch%=OPENIN(file$)
3240 IF ch%=0 THEN =-1
3250 SYS "OS_GBPB",3,ch%,buf%,1,0 TO ,,,unread%
3260 CLOSE#ch%
3270 IF unread%<>0 THEN =-1
3280 =?buf%
3300 DEF FNextent(file$)
3310 LOCAL ch%,size%
3320 ch%=OPENIN(file$)
3330 IF ch%=0 THEN =-1
3340 size%=EXT#ch%
3350 CLOSE#ch%
3360 =size%
