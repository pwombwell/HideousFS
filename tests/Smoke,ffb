1800 DEF PROCmkdir(d$)
1810 LOCAL obj%
1820 SYS "OS_File",5,d$ TO obj%
1830 IF obj%=2 THEN ENDPROC
1840 IF obj%<>0 THEN PRINT "Not a directory: ";d$:errors%=errors%+1:ENDPROC
1850 SYS "OS_File",8,d$
1860 ENDPROC
1900 DEF PROCwrite(file$,text$)
1910 LOCAL ch%,i%
1920 ch%=OPENOUT(file$)
1930 FOR i%=1 TO LEN(text$)
1940 BPUT#ch%,ASC(MID$(text$,i%,1))
1950 NEXT
1960 CLOSE#ch%
1970 ENDPROC
2000 DEF PROCwrite_gbpb(file$,text$)
2010 LOCAL ch%,buf%,i%,unwritten%
2020 DIM buf% LEN(text$)-1
2030 FOR i%=1 TO LEN(text$)
2040 buf%?(i%-1)=ASC(MID$(text$,i%,1))
2050 NEXT
2060 ch%=OPENOUT(file$)
2070 SYS "OS_GBPB",1,ch%,buf%,LEN(text$),0 TO ,,,unwritten%
2080 CLOSE#ch%
2090 IF unwritten%<>0 THEN PRINT "OS_GBPB write left ";unwritten%;" bytes unwritten: ";file$:errors%=errors%+1
2100 ENDPROC
2110 DEF PROCopen_many_read(file$,count%,expect%)
2120 LOCAL i%,byte%
2130 DIM openhandles%(count%-1)
2140 FOR i%=0 TO count%-1
2150 openhandles%(i%)=OPENIN(file$)
2160 IF openhandles%(i%)=0 THEN PRINT "Unable to open projected file handle ";i%;" for ";file$:errors%=errors%+1
2170 NEXT
2180 FOR i%=0 TO count%-1
2190 IF openhandles%(i%)<>0 THEN byte%=BGET#openhandles%(i%):PROCassert(byte%=expect%,"Projected file handle "+STR$(i%)+" reads expected byte")
2200 NEXT
2210 FOR i%=0 TO count%-1
2220 IF openhandles%(i%)<>0 THEN CLOSE#openhandles%(i%)
2230 NEXT
2240 ENDPROC
2300 DEF PROCassert(ok%,msg$)
