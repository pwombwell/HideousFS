10 REM HideousFS smoke tests
20 REM Plain text BBC BASIC; run under RISC OS with HideousFS loaded.
30 ON ERROR PROCerror:END
40 root$="HostFS:$.HideousFSTest"+MID$(STR$(TIME),2)
50 errors%=0
60 PRINT "HideousFS smoke test root: ";root$
70 PROCmkdir(root$)
80 hideous$=root$+".Hideous"
90 beautiful$=root$+".Beautiful"
95 multi$=root$+".Multi"
96 collide$=root$+".Collision"
100 PROCsetup_hideous(hideous$)
110 PROCsetup_beautiful(beautiful$)
115 PROCsetup_multi(multi$)
116 PROCsetup_collision(collide$)
120 PRINT '"Catalogue: Hideous image view"
130 OSCLI "Cat "+hideous$+".View"
140 PRINT '"Catalogue: Beautiful image view"
150 OSCLI "Cat "+beautiful$+".View"
160 PROCwrite(hideous$+".View.c.newhide","hideous save"+CHR$13)
170 PROCassert(FNexists(hideous$+".newhide/c"),"Hideous save created backing newhide/c")
180 PROCassert(FNexists(beautiful$+".h")=0,"Beautiful h bucket absent before save")
190 PROCwrite(beautiful$+".View.header/h","beautiful save"+CHR$13)
200 PROCassert(FNisdir(beautiful$+".h"),"Beautiful save created h backing bucket")
210 PROCassert(FNexists(beautiful$+".h.header"),"Beautiful save created backing h.header")
220 PROCrename(hideous$+".View.c.main",hideous$+".View.c.renamed")
230 PROCassert(FNexists(hideous$+".main/c")=0,"Hideous rename removed backing main/c")
240 PROCassert(FNexists(hideous$+".renamed/c"),"Hideous rename created backing renamed/c")
250 PROCrename(beautiful$+".View.main/c",beautiful$+".View.renamed/c")
260 PROCassert(FNexists(beautiful$+".c.main")=0,"Beautiful rename removed backing c.main")
270 PROCassert(FNexists(beautiful$+".c.renamed"),"Beautiful rename created backing c.renamed")
280 PROCdelete(hideous$+".View.c.renamed")
290 PROCassert(FNexists(hideous$+".renamed/c")=0,"Hideous delete removed backing renamed/c")
300 PROCdelete(beautiful$+".View.renamed/c")
310 PROCassert(FNexists(beautiful$+".c.renamed")=0,"Beautiful delete removed backing c.renamed")
320 PROCdelete(hideous$+".View.Readme")
330 PROCassert(FNexists(hideous$+".Readme")=0,"Hideous delete removed pass-through Readme")
340 PROCdelete(beautiful$+".View.Readme")
350 PROCassert(FNexists(beautiful$+".Readme")=0,"Beautiful delete removed pass-through Readme")
360 PROCwrite(hideous$+".View.c.basichide","PRINT "+CHR$34+"Hideous"+CHR$34+CHR$13)
370 PROCsettype(hideous$+".View.c.basichide",&FFB)
380 PROCassert(FNfiletype(hideous$+".basichide/c")=&FFB,"Hideous projected filetype is &FFB")
390 PROCwrite(beautiful$+".View.basicbeaut/h","PRINT "+CHR$34+"Beautiful"+CHR$34+CHR$13)
400 PROCsettype(beautiful$+".View.basicbeaut/h",&FFB)
410 PROCassert(FNfiletype(beautiful$+".h.basicbeaut")=&FFB,"Beautiful projected filetype is &FFB")
420 PROCassert(FNexists(multi$+".CView.c.onlyc"),"CView maps c-only backing file")
430 PROCassert(FNexists(multi$+".CView.h.onlyh")=0,"CView does not map h-only backing file")
440 PROCassert(FNexists(multi$+".HView.h.onlyh"),"HView maps h-only backing file")
450 PROCassert(FNexists(multi$+".HView.c.onlyc")=0,"HView does not map c-only backing file")
460 PROCassert(FNexists(hideous$+".View.src.c.submain"),"Hideous subdirectory projected file exists")
470 PROCwrite(hideous$+".View.src.c.newsub","hideous subdir save"+CHR$13)
480 PROCassert(FNexists(hideous$+".src.newsub/c"),"Hideous subdirectory save created backing src.newsub/c")
490 PROCassert(FNexists(beautiful$+".View.src.submain/c"),"Beautiful subdirectory projected file exists")
500 PROCwrite(beautiful$+".View.src.subnew/h","beautiful subdir save"+CHR$13)
510 PROCassert(FNexists(beautiful$+".src.h.subnew"),"Beautiful subdirectory save created backing src.h.subnew")
520 PROCassert(FNfirstbyte(collide$+".Hideous.View.c.collision")=ASC("P"),"Hideous collision reads projected backing file")
530 PROCassert(FNfirstbyte(collide$+".Beautiful.View.collision/c")=ASC("P"),"Beautiful collision reads projected backing file")
540 IF errors%=0 THEN PRINT '"PASS: all smoke tests passed" ELSE PRINT '"FAIL: ";errors%;" smoke tests failed"
550 PRINT "Test tree left at: ";root$
560 END
1000 DEF PROCsetup_hideous(d$)
1010 PROCmkdir(d$)
1020 PROCwrite_config(d$+".View","hideous")
1030 PROCwrite(d$+".main/c","int main(void)"+CHR$13)
1040 PROCwrite(d$+".defs/h","#define VALUE 1"+CHR$13)
1050 PROCwrite(d$+".Readme","Hideous backing tree"+CHR$13)
1060 PROCmkdir(d$+".src")
1070 PROCmkdir(d$+".src.submain")
1080 PROCwrite(d$+".src.submain/c","int submain(void)"+CHR$13)
1090 ENDPROC
1100 DEF PROCsetup_beautiful(d$)
1110 PROCmkdir(d$)
1120 PROCwrite_config(d$+".View","beautiful")
1130 PROCmkdir(d$+".c")
1140 PROCwrite(d$+".c.main","int main(void)"+CHR$13)
1150 PROCwrite(d$+".c.util","void util(void)"+CHR$13)
1160 PROCwrite(d$+".Readme","Beautiful backing tree"+CHR$13)
1170 PROCmkdir(d$+".src")
1180 PROCmkdir(d$+".src.c")
1190 PROCwrite(d$+".src.c.submain","int submain(void)"+CHR$13)
1200 ENDPROC
1300 DEF PROCsetup_multi(d$)
1310 PROCmkdir(d$)
1320 PROCwrite_config_ext(d$+".CView","hideous","c")
1330 PROCwrite_config_ext(d$+".HView","hideous","h")
1340 PROCmkdir(d$+".onlyc")
1350 PROCmkdir(d$+".onlyh")
1360 PROCwrite(d$+".onlyc/c","c-only"+CHR$13)
1370 PROCwrite(d$+".onlyh/h","h-only"+CHR$13)
1380 ENDPROC
1400 DEF PROCsetup_collision(d$)
1410 PROCmkdir(d$)
1420 PROCmkdir(d$+".Hideous")
1430 PROCwrite_config_ext(d$+".Hideous.View","hideous","c")
1440 PROCwrite(d$+".Hideous.collision/c","Projected hideous collision"+CHR$13)
1450 PROCmkdir(d$+".Hideous.c")
1460 PROCwrite(d$+".Hideous.c.collision","Raw hideous collision"+CHR$13)
1470 PROCmkdir(d$+".Beautiful")
1480 PROCwrite_config_ext(d$+".Beautiful.View","beautiful","c")
1490 PROCmkdir(d$+".Beautiful.c")
1500 PROCwrite(d$+".Beautiful.c.collision","Projected beautiful collision"+CHR$13)
1510 PROCwrite(d$+".Beautiful.collision/c","Raw beautiful collision"+CHR$13)
1520 ENDPROC
1600 DEF PROCwrite_config(file$,mode$)
1610 PROCwrite_config_ext(file$,mode$,"c h s o a cpp c++")
1620 ENDPROC
1700 DEF PROCwrite_config_ext(file$,mode$,reverse$)
1710 text$="# HideousFS"+CHR$13+"mode "+mode$+CHR$13+"reverse "+reverse$+CHR$13
1720 PROCwrite(file$,text$)
1730 SYS "OS_File",18,file$,&001
1740 ENDPROC
1800 DEF PROCmkdir(d$)
1810 LOCAL obj%
1820 SYS "OS_File",5,d$ TO obj%
1830 IF obj%=2 THEN ENDPROC
1840 IF obj%<>0 THEN PRINT "Not a directory: ";d$:errors%=errors%+1:ENDPROC
1850 SYS "OS_File",8,d$
1860 ENDPROC
1900 DEF PROCwrite(file$,text$)
1910 LOCAL ch%,i%
1920 ch%=OPENOUT(file$)
1930 FOR i%=1 TO LEN(text$)
1940 BPUT#ch%,ASC(MID$(text$,i%,1))
1950 NEXT
1960 CLOSE#ch%
1970 ENDPROC
2000 DEF PROCassert(ok%,msg$)
2010 IF ok% THEN PRINT "PASS: ";msg$ ELSE PRINT "FAIL: ";msg$:errors%=errors%+1
2020 ENDPROC
2100 DEF PROCrename(from$,to$)
2110 OSCLI "Rename "+from$+" "+to$
2120 ENDPROC
2200 DEF PROCdelete(file$)
2210 SYS "OS_File",6,file$
2220 ENDPROC
2300 DEF PROCsettype(file$,type%)
2310 SYS "OS_File",18,file$,type%
2320 ENDPROC
2400 DEF FNexists(file$)
2410 LOCAL obj%
2420 SYS "OS_File",5,file$ TO obj%
2430 =obj%<>0
2500 DEF FNisdir(file$)
2510 LOCAL obj%
2520 SYS "OS_File",5,file$ TO obj%
2530 =obj%=2
2600 DEF FNfiletype(file$)
2610 LOCAL obj%,type%
2620 SYS "OS_File",5,file$ TO obj%
2630 IF obj%=0 THEN =-1
2640 SYS "OS_File",23,file$ TO,,,,,,type%
2650 =type%
2700 DEF FNfirstbyte(file$)
2710 LOCAL ch%,byte%
2720 ch%=OPENIN(file$)
2730 IF ch%=0 THEN =-1
2740 byte%=BGET#ch%
2750 CLOSE#ch%
2760 =byte%
9000 DEF PROCerror
9010 PRINT '"ERROR: ";REPORT$;" at line ";ERL
9020 PRINT "Test tree left at: ";root$
9030 ENDPROC
